# ============================================================
# NEURO-OS — Configuration
# ============================================================

# OBLIGATOIRE — AES-256 (ne jamais changer après avoir enregistré des clés)
# Générer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REMPLACER_PAR_UNE_VRAIE_CLE_64_CHARS_HEX

# IA Providers (au moins un requis)
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Phase 2 — Perception & Motion (optionnels)
HOME_ASSISTANT_URL=http://192.168.1.x:8123
HOME_ASSISTANT_TOKEN=
MQTT_BROKER_URL=mqtt://localhost:1883

# Redis
REDIS_URL=redis://localhost:6379

# Serveur
PORT=3000
NODE_ENV=development
