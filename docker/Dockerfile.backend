FROM node:20-slim

WORKDIR /app

# Install native dependencies for better-sqlite3
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

COPY . .

# Build the frontend
RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
